# ================================
# Trading System 환경 변수 예시
# ================================
# .env 파일을 복사해서 실제 값을 채워 사용하세요.
# $ cp .env.example .env

# --- 증권사 API ---
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCOUNT_NUMBER=

# --- 데이터 소스 ---
DATA_API_KEY=

# --- 데이터베이스 (선택) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_db
DB_USER=trading_user
DB_PASSWORD=

# --- 알림 (선택) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 앱 설정 ---
ENV=development
LOG_LEVEL=INFO
